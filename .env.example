# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- Admin login -------------------------------------------------------
# The dashboard's login screen. Change both before this machine is
# reachable by anyone but you — the built-in defaults are admin / password123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long-and-not-password123

# --- Sessions ------------------------------------------------------------
# Any long random string. If unset, a new one is generated every time the
# server starts, which signs everyone out on every restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Optional --------------------------------------------------------------
# PORT=3000
# LATE_AFTER=09:30
# MATCH_THRESHOLD=0.6
